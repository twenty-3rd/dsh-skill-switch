{
  "name": "dsh-skill-switch",
  "version": "0.4.0",
  "description": "DSH web plugin: project-level skill switches with a panel — one-click block/unblock per project, global skill deletion, a valid/error verdict per skill (in registry + model-invocable + user-invocable, with the failing condition shown), and a read-only detail view listing every on-disk root location of a skill. 项目级 skill 开关 + 全局删除 + 有效/错误判定 + 每处根位置详情面板。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twenty-3rd/dsh-skill-switch.git"
  },
  "homepage": "https://github.com/twenty-3rd/dsh-skill-switch#readme",
  "bugs": {
    "url": "https://github.com/twenty-3rd/dsh-skill-switch/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skill",
    "agent-skills",
    "cordis",
    "plugin"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/**"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run",
    "verify:installed": "node scripts/verify-installed.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.1.7-rc.2 <0.3.0",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
